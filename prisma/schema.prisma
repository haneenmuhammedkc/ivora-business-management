// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  PARTNER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_ACTIVATION
}

enum AuthTokenType {
  ACCOUNT_ACTIVATION
  PASSWORD_RESET
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum InvestorType {
  ADMIN
  PARTNER
  INVESTOR
}

enum PurchaseStatus {
  DRAFT
  IN_PROGRESS
  CLEARED
}

enum QuantityUnit {
  GRAM
  PIECE
}

enum SaleStatus {
  PENDING
  CLEARED
}

enum ExpenseCategory {
  DELIVERY_FREIGHT
  LABOUR_VAULT
  PROCESSING_ASSAYING
  INDIA_EXPENSE
  TRANSFER_FX_FEES
  GENERAL_OVERHEAD
}

enum ExpensePaymentStatus {
  PENDING
  CLEARED
}

enum TransactionType {
  CAPITAL_INWARD
  PROFIT_DISBURSAL
  CAPITAL_RETURN
  OPERATIONAL_PAYMENT
}

enum PaymentMethod {
  DIRECT_BANK_WIRE
  ESCROW_TRANSFER
  CASH_VAULT
  CHEQUE
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  passwordHash       String
  name               String
  phone              String?
  role               UserRole   @default(PARTNER)
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false)
  passwordChangedAt  DateTime?
  twoFactorEnabled   Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  businesses Business[]
  auditLogs  AuditLog[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model AuthToken {
  id          String        @id @default(cuid())
  email       String
  tokenHash   String
  type        AuthTokenType
  attempts    Int           @default(0)
  maxAttempts Int           @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([email])
  @@index([type])
  @@index([expiresAt])
}

model Business {
  id                   String         @id @default(cuid())
  name                 String
  code                 String         @unique
  businessType         String
  description          String?
  totalInvestmentAED   Decimal        @db.Decimal(18, 2)
  adminInvestmentAED   Decimal        @db.Decimal(18, 2)
  partnerInvestmentAED Decimal        @db.Decimal(18, 2)
  partnerId            String
  partnerEquityPct     Decimal        @db.Decimal(5, 2)
  status               BusinessStatus @default(ACTIVE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  partner       User          @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  investors     Investor[]
  investments   Investment[]
  purchases     Purchase[]
  sales         Sale[]
  inventory     Inventory[]
  expenses      Expense[]
  transactions  Transaction[]

  @@index([code])
  @@index([status])
  @@index([partnerId])
}

model Investor {
  id              String       @id @default(cuid())
  name            String
  code            String       @unique
  email           String?
  phone           String?
  type            InvestorType @default(INVESTOR)
  defaultSharePct Decimal?     @db.Decimal(5, 2)
  status          String       @default("ACTIVE")
  businessId      String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  business     Business?     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  investments  Investment[]
  transactions Transaction[]

  @@index([code])
  @@index([status])
  @@index([type])
  @@index([businessId])
}

model Investment {
  id              String   @id @default(cuid())
  investorId      String
  businessId      String
  committedAmount Decimal  @db.Decimal(18, 2)
  profitSharePct  Decimal  @db.Decimal(5, 2)
  allocatedGrams  Decimal? @db.Decimal(18, 3)
  depositDate     DateTime
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  investor Investor @relation(fields: [investorId], references: [id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([investorId])
  @@index([businessId])
}

model Purchase {
  id                      String         @id @default(cuid())
  purchaseCode            String         @unique
  businessId              String
  purchaseDate            DateTime
  sourcingVault           String?
  productType             String
  quantity                Decimal        @db.Decimal(18, 3)
  quantityUnit            QuantityUnit   @default(GRAM)
  quantityGms             Decimal?       @db.Decimal(18, 3)
  basePricePerGm          Decimal?       @db.Decimal(18, 4)
  basePricePerUnitAED     Decimal?       @db.Decimal(18, 4)
  baseAcquisitionValue    Decimal?       @db.Decimal(18, 2)
  transitInsuranceFreight Decimal?       @default(0) @db.Decimal(18, 2)
  vaultHandlingLabour     Decimal?       @default(0) @db.Decimal(18, 2)
  customsSecurity         Decimal?       @default(0) @db.Decimal(18, 2)
  totalLandedCost         Decimal?       @db.Decimal(18, 2)
  status                  PurchaseStatus @default(DRAFT)
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([purchaseDate])
}

model Sale {
  id                   String       @id @default(cuid())
  saleCode             String       @unique
  businessId           String
  saleDate             DateTime
  liquidationDesk      String?
  buyerFirm            String
  productType          String
  quantity             Decimal      @default(0) @db.Decimal(18, 3)
  quantityUnit         QuantityUnit @default(GRAM)
  quantityGms          Decimal?     @db.Decimal(18, 3)
  sellingPricePerGm    Decimal?     @db.Decimal(18, 4)
  basePricePerUnitAED  Decimal?     @db.Decimal(18, 4)
  totalSellingPriceINR Decimal?     @db.Decimal(18, 2)
  inrRealizationValue  Decimal      @db.Decimal(18, 2)
  realizedFxRate       Decimal      @db.Decimal(18, 4)
  aedEquivalent        Decimal      @db.Decimal(18, 2)
  status               SaleStatus   @default(PENDING)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([saleDate])
  @@index([productType])
}

model Inventory {
  id                     String       @id @default(cuid())
  businessId             String
  productType            String
  quantityUnit           QuantityUnit @default(GRAM)
  totalPurchasedQuantity Decimal      @default(0) @db.Decimal(18, 3)
  totalSoldQuantity      Decimal      @default(0) @db.Decimal(18, 3)
  remainingQuantity      Decimal      @default(0) @db.Decimal(18, 3)
  totalCostAED           Decimal      @default(0) @db.Decimal(18, 2)
  carryingValueAED       Decimal      @default(0) @db.Decimal(18, 2)
  averageCostPerUnitAED  Decimal      @default(0) @db.Decimal(18, 4)
  lastPurchaseDate       DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, productType, quantityUnit])
  @@index([businessId])
  @@index([productType])
}

model Expense {
  id                   String               @id @default(cuid())
  expenseCode          String               @unique
  businessId           String
  category             ExpenseCategory
  description          String
  amount               Decimal              @db.Decimal(18, 2)
  expenseDate          DateTime
  status               ExpensePaymentStatus @default(CLEARED)
  paymentMethod        String?
  isPurchaseLandedCost Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([category])
  @@index([expenseDate])
  @@index([status])
}

model Transaction {
  id              String          @id @default(cuid())
  transactionCode String          @unique
  businessId      String
  investorId      String?
  amount          Decimal         @db.Decimal(18, 2)
  type            TransactionType
  paymentMethod   PaymentMethod
  bankReference   String?
  escrowAccount   String?
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  investor Investor? @relation(fields: [investorId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([investorId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
  @@index([userId])
}
